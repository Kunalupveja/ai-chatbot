{
  "name": "zoho-gemini-whatsapp-chatbot",
  "version": "3.0.0",
  "description": "Zoho CRM webhook integration with Gemini AI chatbot, WhatsApp, and Supabase database",
  "main": "server.js",
  "scripts": {
    "start": "node chatbot-server-with-agents.js",
    "dev": "nodemon chatbot-server-with-agents.js",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm install && npm run build",
    "build": "npm run client:build",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "start:supabase": "node chatbot-server-supabase.js",
    "start:simple": "node chatbot-server-simple.js"
  },
  "keywords": [
    "zoho",
    "gemini",
    "whatsapp",
    "chatbot",
    "webhook"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
